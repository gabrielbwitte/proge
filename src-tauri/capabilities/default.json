{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "stage", "stage-2", "stage-3"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "opener:default",
    "updater:default",
    "process:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:scope-home-recursive",
    "fs:scope-picture-recursive",
    "fs:scope-video-recursive",
    "fs:scope-desktop-recursive",
    "fs:scope-download-recursive"
  ]
}