{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proge",
  "version": "0.1.1",
  "identifier": "com.gabrielbwitte.proge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:proge.db"]
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/gabrielbwitte/proge/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2MDM2M0NFMkNBRjhBNwpSV1NuK01yaVBEWmdBbk1PbUJ0WVlqZTM4eE1FL2toWnAwd0lhT3VYVTdQdlVvMmtiTFdRbkZGZAo="
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Proge",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}